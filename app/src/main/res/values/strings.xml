    <!-- FAQ Content -->
    <string name="faq_q1">How long does printing take?</string>
    <string name="faq_a1">Standard orders take 2-3 business days. Bulk orders (over 500 units) take 5-7 business days.</string>
    <string name="faq_q2">Can I cancel my order?</string>
    <string name="faq_a2">Orders can only be cancelled while the status is \"Pending\". Once printing begins, cancellation is not possible.</string>
    <string name="faq_q3">What file format should I use?</string>
    <string name="faq_a3">We recommend PDF for best quality, or PNG for transparent background designs.</string>
    <string name="faq_q4">Do you deliver island-wide in Sri Lanka?</string>
    <string name="faq_a4">Yes, we deliver to all 25 districts. Standard delivery takes 3-5 business days after printing.</string>
    <string name="faq_q5">How do I track my order?</string>
    <string name="faq_a5">Go to \"My Orders\" in the bottom navigation bar. Your order status updates in real-time.</string>
    <string name="faq_q6">What payment methods are accepted?</string>
    <string name="faq_a6">We support Cash on Pickup or Cash on Delivery. Online card payments are coming soon.</string>

